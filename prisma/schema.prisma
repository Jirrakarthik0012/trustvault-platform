generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum AuditAction {
  REGISTER
  LOGIN
  MEMBER_CREATE
  ROLE_CHANGE
  UPLOAD
  VIEW
  SHARE
  REVOKE
  ACCESS_DENIED
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  users     User[]
  documents Document[]
  audits    AuditLog[]
}

model User {
  id             String          @id @default(cuid())
  organizationId String
  email          String
  name           String
  passwordHash   String
  role           Role            @default(VIEWER)
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents      Document[]      @relation("DocumentOwner")
  shares         DocumentShare[]
  audits         AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
}

model Document {
  id             String          @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  originalName   String
  mimeType       String
  size           Int
  storageKey     String          @unique
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          User            @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  shares         DocumentShare[]
  audits         AuditLog[]

  @@index([organizationId, createdAt])
  @@index([ownerId])
}

model DocumentShare {
  id         String    @id @default(cuid())
  documentId String
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId, revokedAt, expiresAt])
}

// Audit records are append-only in application code: no update/delete actions are exposed.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  documentId     String?
  action         AuditAction
  status         AuditStatus
  ipAddress      String
  details        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([documentId, createdAt])
}
