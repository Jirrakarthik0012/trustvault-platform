POSTGRES_USER="trustvault"
POSTGRES_PASSWORD="replace-with-generated-hex-password"
POSTGRES_DB="trustvault"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
DIRECT_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate independent random values (at least 32 characters) for production.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
VIEWER_LINK_SECRET="replace-with-a-different-long-random-secret"
# Private persistent directory mounted to the app host; never serve this as a public web folder.
TRUSTVAULT_STORAGE_DIR=".trustvault-storage"
# Local development uses private filesystem storage; set to vercel-blob on Vercel.
TRUSTVAULT_STORAGE_PROVIDER="filesystem"
# Vercel Blob creates this token when a store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=""
# Required in production. Create these in the Upstash Redis console.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# HTTPS /scan endpoint for a trusted ClamAV bridge. It accepts a raw
# application/octet-stream body and returns {"status":"clean"} or {"status":"infected"}.
CLAMAV_SCAN_URL=""
CLAMAV_SCAN_TOKEN=""
